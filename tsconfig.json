{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@/config/*": ["./config/*"],
      "@/routes/*": ["./routes/*"],
      "@/docs/*": ["../docs/*"]
    }
  },
  "ts-node": {
    "esm": true
  },
  "include": ["src", "docs"],
  "exclude": ["node_modules", "dist", "src/generated/prisma"]
}
